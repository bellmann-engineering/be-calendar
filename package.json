{
  "name": "bellmann-calendar-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Build der statischen Frontend-Assets (Tailwind-CSS, FullCalendar, Schrift) für Bellmann Calendar",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:vendor && npm run build:css",
    "build:vendor": "node frontend/copy-vendor.mjs",
    "build:css": "tailwindcss -i frontend/app.css -o app/static/dist/app.css --minify",
    "watch:css": "tailwindcss -i frontend/app.css -o app/static/dist/app.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "fullcalendar": "6.1.21",
    "tailwindcss": "4.3.3"
  }
}
