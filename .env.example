# =============================================================================
# .env.example – Vorlage für die .env-Datei (DIESE Datei ist in Git, die .env nicht!)
# -----------------------------------------------------------------------------
# Kopieren:  cp .env.example .env   – oder einfach ./setup.sh ausführen.
# Gelesen von: app/config.py (python-dotenv) und docker-compose.yml (${VARIABLE}).
# Secrets erzeugen:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- Umgebung -----------------------------------------------------------------
# production | development | testing. In Docker erzwingt docker-compose.yml "production".
APP_ENV=development
# Nur in development wirksam: 1 = Debugger/Auto-Reload an. In Produktion IMMER aus.
FLASK_DEBUG=0
FLASK_APP=wsgi.py

# --- Sicherheit (Pflicht in Produktion, jeweils mind. 32 Zeichen) --------------
SECRET_KEY=bitte-ersetzen
JWT_SECRET_KEY=bitte-ersetzen
# Laufzeiten der Sitzung
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=8
# 1 = Cookies nur über HTTPS (Standard: Nginx liefert HTTPS auf Port 8443).
# Nur für "python run.py" ohne TLS auf 0 setzen.
COOKIE_SECURE=1

# Öffentliche Adresse (für Links in E-Mails)
APP_BASE_URL=https://localhost:8443
# Öffentliche Ports von Nginx (HTTP leitet auf HTTPS um)
HTTP_PORT=8080
HTTPS_PORT=8443
# Geschäftszeitzone für Datumsangaben ohne Zeitzone
APP_TIMEZONE=Europe/Berlin
LOG_LEVEL=INFO

# --- Datenbank ----------------------------------------------------------------
POSTGRES_USER=bellmann_user
POSTGRES_PASSWORD=bitte-ersetzen
POSTGRES_DB=bellmann_calendar_db
# Für lokales Arbeiten ohne Docker; in Docker baut Compose die URL selbst.
DATABASE_URL=postgresql+psycopg://bellmann_user:bitte-ersetzen@localhost:5432/bellmann_calendar_db
# Nur für pytest (wird bei jedem Testlauf GELÖSCHT!)
TEST_DATABASE_URL=postgresql+psycopg://bellmann_user:bitte-ersetzen@localhost:5432/bellmann_test

# --- Erster CEO-Zugang (seed_dev.py) ------------------------------------------
DEV_USER_EMAIL=dev@bellmann-engineering.com
DEV_USER_PASSWORD=bitte-ersetzen

# --- E-Mail (optional; leer = Versand wird übersprungen) -----------------------
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@bellmann-engineering.com

# --- Optional -------------------------------------------------------------------
# Gemeinsamer Rate-Limit-Speicher für alle Worker (sonst memory:// pro Prozess)
# RATELIMIT_STORAGE_URI=redis://redis:6379/0
# Gunicorn-Dimensionierung (siehe gunicorn.conf.py)
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# Migrationen beim Containerstart (1) oder manuell (0)
# RUN_MIGRATIONS=1
